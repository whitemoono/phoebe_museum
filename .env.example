# Phoebe Museum 环境变量配置示例
# 复制此文件为 .env 并修改配置

# 数据库连接
# 开发环境使用 SQLite
DATABASE_URL="file:./dev.db"

# 生产环境使用 PostgreSQL（取消注释并修改）
# DATABASE_URL="postgresql://username:password@localhost:5432/phoebe_museum"

# JWT 密钥（请修改为强密码）
JWT_SECRET="your-jwt-secret-key-change-in-production"

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Phoebe Museum"

# 图片存储配置
# 本地存储路径
UPLOAD_DIR="./public/uploads"

# 生产环境对象存储配置（后期部署时取消注释）
# STORAGE_TYPE="s3"
# S3_BUCKET="phoebe-museum"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"

# 管理员账户（首次运行时自动创建）
ADMIN_EMAIL="admin@phoebe-museum.com"
ADMIN_PASSWORD="admin123456"
ADMIN_USERNAME="admin"

# Docker 配置
# NEXT_PUBLIC_APP_URL="http://your-domain.com"
# JWT_SECRET="your-strong-jwt-secret"
# ADMIN_EMAIL="admin@your-domain.com"
# ADMIN_PASSWORD="your-strong-admin-password"