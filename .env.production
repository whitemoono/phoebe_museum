# Phoebe Museum 生产环境配置
# 用于Docker构建

# 数据库连接
DATABASE_URL="file:/app/prisma/dev.db"

# JWT 密钥
JWT_SECRET="phoebe-museum-jwt-secret-2026"

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Phoebe Museum"

# 图片存储配置
UPLOAD_DIR="/app/public/uploads"

# 管理员账户
ADMIN_EMAIL="admin@phoebe-museum.com"
ADMIN_PASSWORD="admin123456"
ADMIN_USERNAME="admin"

# Next.js 配置
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production